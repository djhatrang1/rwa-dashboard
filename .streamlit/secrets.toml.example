# Template for Streamlit Cloud secrets. In the Streamlit Cloud UI:
#   App settings → Secrets → paste the contents of this file with real values.
# Locally, prefer a top-level `.env` file (already gitignored).

# Birdeye Data API key (https://docs.birdeye.so).
BIRDEYE_API_KEY = ""

# Postgres connection string from Supabase (Settings → Database → Connection
# pooler → "Transaction" mode for serverless / cron, port 6543).
# Format: postgresql://postgres.<ref>:<PWD>@<host>:6543/postgres
DATABASE_URL = ""

# Optional — only needed if any Claude-powered features are re-enabled.
# ANTHROPIC_API_KEY = ""
